# ====================================================================
# MootCourt Environment Configuration Template
# Copy this file to .env and provide your API keys and service URIs.
# ====================================================================

# --------------------------------------------------------------------
# 1. Graph Database (Neo4j Aura / Local)
# --------------------------------------------------------------------
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=<your-instance-id>
AURA_INSTANCENAME=MootCourt-Instance

# --------------------------------------------------------------------
# 2. Vector Database (Pinecone) & Embeddings
# --------------------------------------------------------------------
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=ipc-index
PINECONE_HOST=
PINECONE_TOP_K=10
HF_TOKEN=<your-huggingface-token>
OCR_PROVIDER=vision
GOOGLE_VISION_CREDENTIALS_PATH=vision-ai.json
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# --------------------------------------------------------------------
# 3. LLM Provider Configuration
# --------------------------------------------------------------------
# Options: "openai" | "ollama" | "groq"
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=sk-<your-openai-api-key>
OPENAI_MODEL=gpt-5.4-mini

# Ollama Settings (Local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# Groq Settings (Fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# --------------------------------------------------------------------
# 4. Model Tiers & Per-Stage Model Pinning
# --------------------------------------------------------------------
# When OPT_CHEAP_MODELS is false, stages restore these original models exactly.
MODEL_STAGE0=gpt-5.4-mini
MODEL_STAGE1=gpt-5.4-mini
MODEL_STAGE2=gpt-5.4-mini
MODEL_STAGE3=gpt-5.4-mini
MODEL_STAGE4=gpt-5.4-mini
MODEL_STAGE5=gpt-5.4-mini
MODEL_STAGE6=gpt-5.4-mini
MODEL_STAGE7=gpt-5.4-mini

# Courtroom Debate Agents (Judge, Defense, Prosecutor)
MODEL_COURTROOM=gpt-5.4-mini

# Two-tier aliases
MODEL_STRONG=gpt-5.4-mini
MODEL_CHEAP=gpt-4o-mini
MAX_CALLS_PER_RUN=25

# --------------------------------------------------------------------
# 5. Redis Cache & Networking
# --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------------------------------------------------------------
# 6. Courtroom Simulation & Evaluation Parameters
# --------------------------------------------------------------------
ORCHESTRATOR_MAX_ROUNDS=2
JUDGE_THRESHOLD=6.0
INGREDIENT_MIN_THRESHOLD=0.45
LEXIGRAPH_INGREDIENT_CUTOFF=0.45
MAX_CITATION_RETRIES=1

# ====================================================================
# 7. Token Optimization Suite (Bottlenecks 1-4) & Feature Gates
# ====================================================================
# Safe optimizations (Default: ON / true)
OPT_LEXIGRAPH_CACHE=true               # Key pipeline on sha256(doc_text) in Redis/disk (0 tokens on re-run)
OPT_COMPACT_JSON=true                  # Compact json.dumps separators and strip internal debug/verifier logs
OPT_STAGE_SLICES=true                  # Pass lean typed slices per stage instead of full 2500-token text
OPT_EVIDENCE_STAGE0_REUSE=true         # Evidence analyzer reuses Stage 0 facts/inventory directly
OPT_SUMMARIZE_TRANSCRIPT=true          # Keep last 1-2 turns verbatim and summarize earlier turns
OPT_COLLAPSE_RETRIES=true              # Capped 1-2 attempts total with targeted repair prompt

# Quality-sensitive optimizations (Default: OFF / false - test before adopting)
OPT_CHEAP_MODELS=false                 # Use cheap model tier (gpt-4o-mini) for easy stages (0, 1, 3) and verifiers
OPT_SKIP_REASONING_GATE=false          # Skip LLM reasoning in analyze_case when top 5 have >=0.92 confidence
OPT_VERIFIER_BYPASS_STAGE0=false       # Bypass Stage 0 LLM verifier if programmatic contract + grounding pass
OPT_VERIFIER_BYPASS_STAGE2=false       # Bypass Stage 2 LLM verifier if programmatic contract passes

# --------------------------------------------------------------------
# 8. Cache Configuration & Invalidation Keys
# --------------------------------------------------------------------
LEXIGRAPH_CACHE_BACKEND=redis          # redis | disk | none
LEXIGRAPH_CACHE_TTL=259200             # 72 hours in seconds
LEXIGRAPH_CACHE_DIR=data/lexigraph_cache
PROMPT_VERSION=v1.0                    # Cache key prompt version component
CACHE_NAMESPACE=prod                   # Namespace (e.g. prod, baseline_run, test)
